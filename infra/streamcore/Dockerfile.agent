# سام — StreamCore HTTP Agent
FROM python:3.11-slim

WORKDIR /app

# بدون cache pip برای حجم کمتر
COPY apps/streamcore-agent/pyproject.toml apps/streamcore-agent/README.md ./
COPY apps/streamcore-agent/src ./src
COPY prompts ./prompts
COPY knowledge ./knowledge
COPY .env.example ./.env.example

RUN pip install --no-cache-dir -e .

# برای RAG: اگر chromadb لازمه
RUN pip install --no-cache-dir chromadb 2>/dev/null || echo "chromadb optional"

EXPOSE 8000

CMD ["uvicorn", "sam_streamcore.server:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
