FROM python:3.11-slim
WORKDIR /app
COPY apps/agent/pyproject.toml apps/agent/requirements.txt* ./apps/agent/
COPY apps/agent/src ./apps/agent/src
RUN pip install --no-cache-dir -e ./apps/agent
COPY prompts ./prompts
COPY knowledge ./knowledge
ENV PYTHONPATH=/app/apps/agent/src
CMD ["python","-m","sam.agent","start"]
