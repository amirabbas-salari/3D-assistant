# LiveKit Cloud credentials (API secret stays on the server)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_AGENT_NAME=hamrah-agent

# Master switch for the avatar.
# "false" runs the full STT + LLM + TTS pipeline with the agent's own LiveKit
# audio output, and skips the avatar entirely (its credentials are then optional).
# Set to "true" to bring the avatar back.
AVATAR_ENABLED=false

# Which avatar backend runs when AVATAR_ENABLED=true:
#   did      D-ID Expressive Agent joins this LiveKit room and publishes
#            lip-synced video + audio (recommended)
#   spatius  Spatius renders the avatar in the browser with AvatarKit
AVATAR_PROVIDER=did

# D-ID realtime avatar (LiveKit plugin). D-ID_API_KEY is the Basic-auth key from
# https://studio.d-id.com/account-settings; it stays on the server and in the agent.
# DID_AGENT_ID is the Expressive Agent id (agt_...) you create in D-ID Studio.
DID_API_KEY=your_did_api_key
DID_AGENT_ID=agt_your_agent_id
# D-ID accepts 16000, 24000 or 48000 Hz; it resamples when the TTS rate differs.
DID_AUDIO_SAMPLE_RATE=24000

# Spatius real-time avatar (API key stays server-side; IDs are safe to expose to web SDK)
SPATIUS_API_KEY=your_spatius_api_key
SPATIUS_APP_ID=your_spatius_app_id
SPATIUS_AVATAR_ID=your_spatius_avatar_id
# Optional: pin a region, e.g. us-west, ap-northeast, or cn-beijing
SPATIUS_REGION=auto
SPATIUS_SAMPLE_RATE=24000
# PCM avoids a separate native libopus install; use ogg_opus only when libopus is installed
SPATIUS_AUDIO_FORMAT=pcm_s16le

# Cloudflare Workers AI (create an API token with Workers AI permission)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Raise Workers AI's default 256-token output cap, especially for read-aloud text
CLOUDFLARE_LLM_MAX_TOKENS=8192

# Where STT and TTS come from.
#   inference -> LiveKit Inference gateway (no provider keys, but the Build plan
#                has a monthly credit allowance; once it is spent every STT/TTS
#                connection fails with HTTP 429 until the next billing cycle)
#   direct    -> call Deepgram and Google directly with your own keys; no
#                LiveKit allowance involved, but you need the two keys below
SPEECH_PROVIDER=inference

# Only used when SPEECH_PROVIDER=direct.
# Deepgram: console.deepgram.com -> API Keys
DEEPGRAM_API_KEY=
# Google: aistudio.google.com/apikey (a Gemini API key, not a service account)
GOOGLE_API_KEY=

# LiveKit Inference — Persian STT
LIVEKIT_STT_MODEL=deepgram/nova-3
LIVEKIT_STT_LANGUAGE=fa

# LiveKit Inference TTS (no separate provider API key)
LIVEKIT_TTS_MODEL=google/gemini-3.8-flash-lite-tts
# Male Gemini voices: Charon, Orus, Fenrir, Puck, Iapetus, Algenib, Schedar, Achird
LIVEKIT_TTS_VOICE=Charon
LIVEKIT_TTS_LANGUAGE=fa

# --- Speed -------------------------------------------------------------------
# Preset for the two waits that are not the models' fault:
#   balanced -> SDK defaults (endpointing 0.3/2.5 s, no preemptive TTS)
#   fast     -> endpointing 0.2/2.0 s + preemptive LLM and TTS   (~100-400 ms/turn)
#   fastest  -> endpointing 0.12/1.5 s + preemptive LLM and TTS  (interrupts pauses)
# Preemptive generation starts the LLM on the interim transcript and the TTS
# before the turn is confirmed, so the first word comes out sooner. `fastest`
# answers if you merely pause mid-sentence: use it only with a headset.
AGENT_SPEED_PROFILE=balanced

# --- Latency instrumentation -------------------------------------------------
# One log line per turn with every stage in milliseconds, plus a rolling summary
# that names the slowest stage. Set LATENCY_LOG=false to keep the summary only.
LATENCY_LOG=true
# Summarise every N turns; 0 disables the periodic summary.
LATENCY_REPORT_INTERVAL=5
# Latency knobs. Empty means "use the SDK default" (min 0.3 s / max 2.5 s with
# the streaming turn detector), so nothing changes until you measure and decide.
# Lowering AGENT_MIN_ENDPOINTING_DELAY makes the agent answer sooner but cuts in
# on slow speakers more often.
AGENT_MIN_ENDPOINTING_DELAY=
AGENT_MAX_ENDPOINTING_DELAY=
# Start TTS before the turn is confirmed: removes the first-sentence wait at the
# cost of synthesising speech the user may never hear. Empty = off.
AGENT_PREEMPTIVE_TTS=

# LiveKit Inference caps concurrent STT/TTS connections per project (5 each on
# the Build plan). A burst of connections answers 429, so the SDK is told to
# wait and retry more patiently instead of failing the turn.
LIVEKIT_INFERENCE_MAX_RETRY=6
LIVEKIT_INFERENCE_RETRY_INTERVAL=3.0
LIVEKIT_INFERENCE_TIMEOUT=15.0

PORT=3001
