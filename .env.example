# LiveKit Cloud credentials (API secret stays on the server)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_AGENT_NAME=hamrah-agent

# Tavus: create a PAL with pipeline_mode=echo and LiveKit transport
TAVUS_API_KEY=your_tavus_api_key
TAVUS_PAL_ID=your_livekit_echo_pal_id
TAVUS_FACE_ID=your_tavus_face_id

# OpenRouter LLM (OpenRouter model IDs, e.g. openrouter/auto or provider/model)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openrouter/auto

# LiveKit Inference models — Persian STT/TTS
LIVEKIT_STT_MODEL=deepgram/nova-3
LIVEKIT_STT_LANGUAGE=fa
LIVEKIT_TTS_MODEL=google/gemini-3.8-flash-tts
LIVEKIT_TTS_VOICE=Kore
LIVEKIT_TTS_LANGUAGE=fa

PORT=3001
