# LiveKit Cloud credentials (API secret stays on the server)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
# Two names, deliberately separate:
#   LIVEKIT_AGENT_NAME  the dispatch name. LiveKit registers the worker under
#                       it, so the server and the agent must agree. Renaming it
#                       means re-registering the worker (`lk agent create` or
#                       a restart) — it never reaches the user.
#   ASSISTANT_NAME      what the assistant calls itself out loud. Safe to change
#                       without touching LiveKit.
LIVEKIT_AGENT_NAME=sam-voice-agent
ASSISTANT_NAME=سام

# Master switch for the avatar.
# "false" runs the full STT + LLM + TTS pipeline with the agent's own LiveKit
# audio output, and skips the avatar entirely (its credentials are then optional).
# Set to "true" to bring the avatar back.
AVATAR_ENABLED=false

# Which avatar backend runs when AVATAR_ENABLED=true:
#   did      D-ID Expressive Agent joins this LiveKit room and publishes
#            lip-synced video + audio (recommended)
#   spatius  Spatius renders the avatar in the browser with AvatarKit
AVATAR_PROVIDER=did

# D-ID realtime avatar (LiveKit plugin). D-ID_API_KEY is the Basic-auth key from
# https://studio.d-id.com/account-settings; it stays on the server and in the agent.
# DID_AGENT_ID is the Expressive Agent id (agt_...) you create in D-ID Studio.
DID_API_KEY=your_did_api_key
DID_AGENT_ID=agt_your_agent_id
# D-ID accepts 16000, 24000 or 48000 Hz; it resamples when the TTS rate differs.
DID_AUDIO_SAMPLE_RATE=24000

# Spatius real-time avatar (API key stays server-side; IDs are safe to expose to web SDK)
SPATIUS_API_KEY=your_spatius_api_key
SPATIUS_APP_ID=your_spatius_app_id
SPATIUS_AVATAR_ID=your_spatius_avatar_id
# Optional: pin a region, e.g. us-west, ap-northeast, or cn-beijing
SPATIUS_REGION=auto
SPATIUS_SAMPLE_RATE=24000
# PCM avoids a separate native libopus install; use ogg_opus only when libopus is installed
SPATIUS_AUDIO_FORMAT=pcm_s16le

# --- LLM Provider: OpenRouter (پیشنهادی) یا Cloudflare Workers AI ---
# انتخاب ارائه‌دهنده:
#   LLM_PROVIDER=openrouter   → از OpenRouter (https://openrouter.ai) — یک کلید برای 500+ مدل، OpenAI-compatible
#   LLM_PROVIDER=cloudflare   → از Cloudflare Workers AI (قدیمی)
# اگر LLM_PROVIDER را خالی بگذارید، خودکار تشخیص می‌دهد: اگر OPENROUTER_API_KEY پر باشد → openrouter، وگرنه cloudflare

# ۱) OpenRouter (پیشنهادی — برای llm از openrouter استفاده کنید)
# API key را از https://openrouter.ai/settings/keys بگیرید (free tier دارد)
OPENROUTER_API_KEY=
OPENROUTER_LLM_MODEL=openai/gpt-4o-mini
# مدل‌های پیشنهادی OpenRouter برای فارسی و voice (همه streaming):
#   openai/gpt-4o-mini                 → سریع‌ترین و ارزان، فارسی عالی (پیش‌فرض)
#   google/gemini-2.0-flash-001         → فوق‌سریع (TTFT ~120ms)
#   meta-llama/llama-3.3-70b-instruct   → همان llama قبلی ولی via OpenRouter
#   anthropic/claude-3.5-haiku         → سریع و باکیفیت
#   deepseek/deepseek-chat             → ارزان
OPENROUTER_LLM_MAX_TOKENS=150
# کوتاه نگه‌داشتن جواب: 120-180 توکن = 1-2 جمله + سوال (حوصله سر نره). فقط وقتی کاربر گفت «کامل توضیح بده» ببر بالا
# Optional: هدرهای OpenRouter برای رتبه‌بندی (اختیاری)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://yourdomain.com
# OPENROUTER_X_TITLE=3D-assistant
# برای voice حالت thinking همیشه خاموش است (پیش‌فرض). برای روشن کردنِ عمدی:
# OPENROUTER_INCLUDE_REASONING=true
# OPENROUTER_REASONING_EFFORT=low  # فقط اگر thinking را روشن کردید

# ۲) Cloudflare Workers AI (جایگزین قدیمی — اگر هنوز می‌خواهید)
# اگر OPENROUTER_API_KEY ندارید، این را پر کنید:
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Ultra-fast alternative: @cf/meta/llama-3.1-8b-instruct (TTFT ~80-120ms)
#   llama-3.3-70b-fp8-fast:  TTFT ~150-300ms, best balance for voice
#   gpt-oss-120b:            TTFT 1.0-5.4s measured — NOT for sub-1s
CLOUDFLARE_LLM_MAX_TOKENS=150
# How hard gpt-oss thinks before it emits its first token.
CLOUDFLARE_LLM_REASONING_EFFORT=low
CLOUDFLARE_LLM_REASONING_NESTED=false

# Generic fallbacks (اگر مدل مشترک می‌خواهید):
# LLM_PROVIDER=openrouter
# LLM_MODEL=openai/gpt-4o-mini
# LLM_MAX_TOKENS=150

# Where STT and TTS come from.
#   inference -> LiveKit Inference gateway (no provider keys, but the Build plan
#                has a monthly credit allowance; once it is spent every STT/TTS
#                connection fails with HTTP 429 until the next billing cycle)
#   direct    -> call Deepgram and Google directly with your own keys; no
#                LiveKit allowance involved, but you need the two keys below
SPEECH_PROVIDER=inference

# Only used when SPEECH_PROVIDER=direct.
# Deepgram: console.deepgram.com -> API Keys
DEEPGRAM_API_KEY=
# Google: aistudio.google.com/apikey (a Gemini API key, not a service account)
GOOGLE_API_KEY=

# LiveKit Inference — Persian STT
LIVEKIT_STT_MODEL=deepgram/nova-3
LIVEKIT_STT_LANGUAGE=fa

# LiveKit Inference TTS (no separate provider API key)
LIVEKIT_TTS_MODEL=google/gemini-3.8-flash-lite-tts
# Male Gemini voices: Charon, Orus, Fenrir, Puck, Iapetus, Algenib, Schedar, Achird
LIVEKIT_TTS_VOICE=Charon
LIVEKIT_TTS_LANGUAGE=fa

# --- OpenRouter TTS (elevenlabs/eleven-v3-conversational) — جایگزین Cloudflare ---
# قبلاً این مدل از Cloudflare گرفته می‌شد؛ حذف شد و به OpenRouter منتقل شد.
# TTS_PROVIDER controls which TTS is used. Unset = follows SPEECH_PROVIDER.
#   inference  → LiveKit Inference (default, google/gemini-3.8-flash-lite-tts)
#   direct     → Google direct (needs GOOGLE_API_KEY)
#   openrouter → OpenRouter via elevenlabs/eleven-v3-conversational (needs OPENROUTER_API_KEY)
#   elevenlabs → مستقیم از elevenlabs.io با مدل eleven_flash_v2_5 (نیاز به ELEVENLABS_API_KEY)
# Examples:
#   TTS_PROVIDER=openrouter         # use OpenRouter eleven-v3-conversational (پیشنهادی برای کیفیت مکالمه)
#   TTS_PROVIDER=elevenlabs         # مستقیم از ElevenLabs با eleven_flash_v2_5
#   TTS_PROVIDER=inference          # force back to LiveKit Inference
TTS_PROVIDER=inference
OPENROUTER_API_KEY=
OPENROUTER_TTS_MODEL=elevenlabs/eleven-v3-conversational
OPENROUTER_TTS_VOICE=george
# Voices for eleven-v3-conversational: george, sarah, adam, alice, bella, bill, brian, callum, charlie, chris, daniel, eric, harry, jessica, laura, liam, lily, matilda, river, roger, will
# See https://openrouter.ai/elevenlabs/eleven-v3-conversational
OPENROUTER_TTS_RESPONSE_FORMAT=mp3
# Optional overrides:
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://yourdomain.com
# OPENROUTER_X_TITLE=3D-assistant
# OPENROUTER_TTS_SAMPLE_RATE=24000
# OPENROUTER_TTS_FALLBACK=true  # if openrouter 402/429, fallback to inference

# --- ElevenLabs direct (eleven_flash_v2_5) — پیشنهادی برای کیفیت/سرعت بالا ---
# مستقیم از elevenlabs.io (نه از Cloudflare). فعال‌سازی:
#   TTS_PROVIDER=elevenlabs
#   ELEVENLABS_API_KEY=sk_...  # از https://elevenlabs.io/app/settings/api-keys
#   ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb  # یا هر voice دلخواه
ELEVENLABS_API_KEY=
# ELEVEN_API_KEY=  # نام جایگزین همین کلید
ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_ENCODING=mp3_22050_32  # گزینه‌ها: mp3_22050_32, pcm_24000, pcm_16000 و...
# مدل‌های ElevenLabs: eleven_flash_v2_5 (سریع‌ترین، پیشنهادی)، eleven_turbo_v2_5، eleven_multilingual_v2، eleven_v3، eleven_v4_turbo
# eleven_flash_v2_5: تاخیر ~75ms، عالی برای voice agent — https://elevenlabs.io/docs/models

# --- Speed -------------------------------------------------------------------
# Preset for the two waits that are not the models' fault (target <1s e2e):
#   ultra    -> endpointing 0.08/1.0 s + preemptive LLM+TTS + tuned interruption (default, needs headset/quiet)
#   fastest  -> endpointing 0.12/1.5 s + preemptive LLM and TTS
#   fast     -> endpointing 0.2/2.0 s + preemptive LLM and TTS   (~100-400 ms/turn)
#   balanced -> endpointing 0.3/2.5 s + preemptive LLM+TTS        (conservative)
# Preemptive generation starts the LLM on the interim transcript and the TTS
# before the turn is confirmed, so the first word comes out sooner.
# For sub-1s: use ultra/instant + llama-3.3-70b-fp8-fast (or llama-3.1-8b for ~80ms TTFT).
# 1.90s → <1s: change to instant + 8b model. Need headset for instant.
AGENT_SPEED_PROFILE=ultra
# Fine-tune endpointing if needed (overrides profile):
# AGENT_MIN_ENDPOINTING_DELAY=0.08
# AGENT_MAX_ENDPOINTING_DELAY=1.0
# Start every answer with ONE short sentence that already carries the answer (5-9 words → TTS starts at sentence boundary).
# TTS makes one request per sentence and each request is a round-trip, so a reply
# made of several tiny sentences ("حتماً." / "بذارید چک کنم." / then the answer)
# is heard as pausing, however fast it starts. The instructions ask for one
# complete first sentence of ~5-9 words (with answer) instead. Set to false to remove the
# guidance entirely. Streaming: LLM tokens stream token-by-token via OpenAI streaming API;
# TTS starts at first sentence boundary (not after full answer) via SDK StreamAdapter.
AGENT_FAST_START=true
# اگر sales_playbook بزرگ باشد، آن را کوتاه می‌کند تا TTFT کم شود (پیش‌فرض 3500 کاراکتر نگه می‌دارد)
AGENT_COMPACT_PROMPT=true
# تاریخچه‌ی مکالمه بعد از چند نوبت طولانی، LLM را کند می‌کند (هر نوبت +~400 توکن)
# این عدد حداکثر پیامِ نگه‌داشته در chat history است (پیش‌فرض 12 = ۶ نوبت). بیشتر = دقیق‌تر ولی کندتر
AGENT_MAX_HISTORY_ITEMS=12

# --- Latency instrumentation -------------------------------------------------
# One log line per turn with every stage in milliseconds, plus a rolling summary
# that names the slowest stage. Set LATENCY_LOG=false to keep the summary only.
LATENCY_LOG=true
# Summarise every N turns; 0 disables the periodic summary.
LATENCY_REPORT_INTERVAL=5
# Latency knobs. Empty means "use the SDK default" (min 0.3 s / max 2.5 s with
# the streaming turn detector), so nothing changes until you measure and decide.
# Lowering AGENT_MIN_ENDPOINTING_DELAY makes the agent answer sooner but cuts in
# on slow speakers more often.
AGENT_MIN_ENDPOINTING_DELAY=
AGENT_MAX_ENDPOINTING_DELAY=
# Start TTS before the turn is confirmed: removes the first-sentence wait at the
# cost of synthesising speech the user may never hear. Empty = off.
# Preemptive TTS is already on in every speed profile (it makes the next
# sentence's audio ready before the current one finishes). These overrides exist
# for turning it off, or for tuning the interruption behaviour that can also be
# heard as a pause:
#   AGENT_PREEMPTIVE_TTS=false            back to LLM-only preemption
#   AGENT_INTERRUPTION_MIN_DURATION=0.8   ignore noises shorter than this (SDK: 0.5)
#   AGENT_FALSE_INTERRUPTION_TIMEOUT=0.8  resume sooner after a false interruption (SDK: 2.0)
AGENT_PREEMPTIVE_TTS=

# LiveKit Inference caps concurrent STT/TTS connections (5 each on Build plan).
# بهینه برای voice: retry کمتر و سریع‌تر — 18s → ~6s در 429
# مقادیر قدیمی 6/3.0/15 کند بود؛ مقادیر جدید برای کمترین تاخیر
LIVEKIT_INFERENCE_MAX_RETRY=4
LIVEKIT_INFERENCE_RETRY_INTERVAL=1.5
LIVEKIT_INFERENCE_TIMEOUT=10.0

# --- Sales assistant ----------------------------------------------------------
# The selling behaviour (tone, conversation flow, objection handling) lives in
# prompts/sales_playbook.md, not in the knowledge base: it belongs in every
# prompt, while the knowledge base is read on demand by the search tool. Edit
# that file to change how the assistant sells; no restart of the model needed.
SALES_PLAYBOOK=prompts/sales_playbook.md

# --- RAG (knowledge base) -----------------------------------------------------
# Adds a `search_knowledge` tool the model calls for factual questions about
# your organisation. Off by default: with it off, nothing changes and chromadb
# is never imported.
#
#   1. put .md / .txt documents in knowledge/
#   2. pip install chromadb
#   3. python scripts/build_rag_index.py
#   4. RAG_ENABLED=true
RAG_ENABLED=false
# RAG_PRELOAD=true → دانش قبلِ LLM تزریق میشه و LLM یک‌ضرب استریم می‌کنه (زیر ۱ ثانیه). false → ابزار search_knowledge (۲ راند LLM، کندتر اما دقیق).
RAG_PRELOAD=false
# Folder of documents, and where the Chroma index is stored (git-ignored).
RAG_DOCS_DIR=knowledge
RAG_STORE_DIR=.rag/chroma
RAG_COLLECTION=knowledge
# How many chunks the tool hands the model. Each extra chunk is more prompt to
# process before the first token, so keep this small unless recall is poor.
RAG_TOP_K=3
# Target chunk size in characters. Bigger chunks mean fewer, longer lookups.
RAG_CHUNK_CHARS=700

# Allow embedding widget on these origins (comma-separated). * = any site (default for quick test).
WIDGET_ALLOWED_ORIGINS=*

PORT=3001
