{
  "name": "3d-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --config apps/web/vite.config.js --host 0.0.0.0",
    "dev:server": "node apps/api/src/index.js",
    "dev:legacy:client": "vite --host 0.0.0.0",
    "dev:legacy:server": "node server/index.js",
    "build": "vite build --config apps/web/vite.config.js && node -e \"import fs from 'node:fs'; fs.cpSync('apps/web/dist','dist',{recursive:true,force:true}); console.log('→ dist synced for legacy serve')\"",
    "build:legacy": "vite build",
    "start": "node apps/api/src/index.js",
    "start:legacy": "node server/index.js",
    "check": "python scripts/check_voice_flow.py && python scripts/check_retrieval.py"
  },
  "dependencies": {
    "@spatius/avatarkit": "^1.3.11",
    "@spatius/avatarkit-rtc": "^1.1.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "livekit-client": "^2.24.1",
    "livekit-server-sdk": "^2.19.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
