{
  "name": "3d-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --config apps/web/vite.config.js --host 0.0.0.0",
    "dev:api": "node apps/api/src/index.js",
    "dev:agent": "python -m sam.agent start",
    "build": "vite build --config apps/web/vite.config.js",
    "build:all": "npm run build && docker compose -f infra/docker/docker-compose.yml build",
    "start": "node apps/api/src/index.js",
    "check": "python scripts/check_env.py && python scripts/check_voice_flow.py && python scripts/check_retrieval.py",
    "lint": "ruff check apps/agent/src && npm run lint --workspaces 2>/dev/null || true",
    "clean": "rm -rf dist apps/web/dist .rag"
  },
  "dependencies": {
    "@spatius/avatarkit": "^1.3.11",
    "@spatius/avatarkit-rtc": "^1.1.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "livekit-client": "^2.24.1",
    "livekit-server-sdk": "^2.19.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
