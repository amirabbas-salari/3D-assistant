{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "language",
    "domain",
    "scenario",
    "channel",
    "synthetic",
    "messages"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "language": {
      "enum": [
        "fa",
        "en"
      ]
    },
    "domain": {
      "enum": [
        "sales",
        "crm"
      ]
    },
    "scenario": {
      "type": "string"
    },
    "channel": {
      "enum": [
        "voice",
        "chat"
      ]
    },
    "synthetic": {
      "const": true
    },
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "expected_crm": {
      "type": "object"
    }
  }
}
