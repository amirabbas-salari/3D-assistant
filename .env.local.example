# ── لوکال کامل — کپی کنید به .env برای اجرای بدون Cloud ─────
# cp .env.local.example .env
# سپس کلیدهای OpenRouter/Deepgram/Google را پر کنید

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=sam-voice-agent
ASSISTANT_NAME=سام

# LiveKit لوکال Inference ندارد — حتما direct/openrouter
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-xxx
OPENROUTER_LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_LLM_MAX_TOKENS=120

# STT/TTS لوکال — دو گزینه:
# گزینه ۱ (پیشنهادی): direct via Deepgram + Google
SPEECH_PROVIDER=direct
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=
LIVEKIT_STT_MODEL=deepgram/nova-3
LIVEKIT_STT_LANGUAGE=fa
LIVEKIT_TTS_MODEL=google/gemini-3.8-flash-lite-tts
LIVEKIT_TTS_VOICE=Charon
LIVEKIT_TTS_LANGUAGE=fa

# گزینه ۲: TTS via OpenRouter (نیاز به OPENROUTER_API_KEY)
# TTS_PROVIDER=openrouter
# OPENROUTER_TTS_MODEL=elevenlabs/eleven-v3-conversational
# OPENROUTER_TTS_VOICE=george

# گزینه ۳: ElevenLabs direct
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=sk-...
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

AVATAR_ENABLED=false
AVATAR_PROVIDER=tavus
# TAVUS_API_KEY=
# TAVUS_REPLICA_ID=
# TAVUS_PERSONA_ID=

AGENT_SPEED_PROFILE=ultra
PORT=3001
